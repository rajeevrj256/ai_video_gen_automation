# --- AI (Claude picks the topic, writes the script, and reviews the video) ---
# auto = use Claude Code on this computer if installed (your login, no API key),
#        otherwise the API key below.
REEL_AI_BACKEND=auto
# Only needed for the "api" backend (and for GitHub Actions).
ANTHROPIC_API_KEY=
# Claude model and effort for every step (also in Settings). Empty = claude-opus-5-5 / high.
CLAUDE_MODEL=
REEL_CLAUDE_EFFORT=
# Fact-check model and effort (default claude-sonnet-5-5, medium). Scripts, fixes and reviews use CLAUDE_MODEL.
REEL_FACT_MODEL=
REEL_FACT_EFFORT=

# Optional: free key from https://www.pexels.com/api/ for real stock footage.
# Without it, videos use animated gradient backgrounds.
PEXELS_API_KEY=

# Optional: get the finished video + caption on Telegram.
# Create a bot with @BotFather, then message it and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Content settings
REEL_GEO=IN                 # Google Trends country (IN, US, GB, ...)
REEL_LANGUAGE=English       # narration language (English, Hindi, ...)
REEL_VOICE=en-US-AndrewMultilingualNeural   # presenter voice; Hindi: hi-IN-MadhurNeural / hi-IN-SwaraNeural
REEL_VOICE_RATE=+10%        # speaking pace for the whole voiceover
REEL_TTS=auto               # auto | edge (Microsoft, online) | kokoro (offline, on this computer)
REEL_KOKORO_VOICE=          # optional, e.g. af_heart (most natural), am_michael, hm_omega
REEL_NICHE=                 # optional, e.g. "tech and AI", "finance", "facts"
REEL_SECONDS=30             # target length, 30 at most
REEL_STYLE=facts            # facts | story | comedy | mix
REEL_CAPTIONS=off           # subtitles burned into videos: off (default) | on

# --- Long videos (8-10 min, 16:9) ---
REEL_LONG_MINUTES=8         # 8-10
REEL_LONG_VOICE=en-US-AndrewMultilingualNeural   # Indian English voice: en-IN-PrabhatNeural
REEL_LONG_LANGUAGE=Indian English

# --- Your own voiceover: speech-to-text model for the word check ---
REEL_WHISPER_MODEL=base     # tiny | base | small (small = more accurate, slower)

# --- Automatic quality check ---
REEL_MAX_ATTEMPTS=3         # regenerate up to this many times if a video fails review
REEL_GPU_BITRATE=           # with REEL_HWACCEL: video bitrate for GPU encoding (default 8M long, 12M Shorts)
REEL_CHROME=                # optional: 'chrome-for-testing' (GPU on Windows, with REEL_GL empty; check: npx remotion gpu --chrome-mode=chrome-for-testing), or a Chrome/Chromium path
# Speed on a strong PC (leave empty for defaults):
REEL_CONCURRENCY=           # frames rendered in parallel; empty = every core
REEL_PARALLEL=2             # videos made at the same time in a batch (also in the app's Settings)
REEL_PARALLEL_RENDERS=1     # of those, how many may render at once; raise on 16+ cores
REEL_GL=                    # GPU for the renderer's browser: leave empty with REEL_CHROME=chrome-for-testing on Windows; egl (Linux)
REEL_HWACCEL=               # if-possible = GPU video encoding where supported

# --- Local app (start.bat / start.sh, or: python -m reelgen serve) ---
REEL_PORT=8765
REEL_APP_PIN=               # set a PIN so only you can use the app on your Wi-Fi
REEL_ALLOWED_IPS=           # optional: only these IPs/networks may open the app (this computer always can)
REEL_TUNNEL=                # quick = open from anywhere via a free Cloudflare link (needs cloudflared and a PIN of 6+)
REEL_TUNNEL_TOKEN=          # or a named Cloudflare tunnel's token (fixed address on your own domain)...
REEL_PUBLIC_URL=            # ...and that address, e.g. https://reels.example.com
REEL_SCHEDULE=              # e.g. 08:30 to make one video every day (can also set in the app)
REEL_OUTPUT_DIR=            # where videos are saved; empty = ai-reels-generator/output
